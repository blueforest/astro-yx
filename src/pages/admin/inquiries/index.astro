---
import { getCloudflareEnv } from "../../../lib/cloudflare-env";
import { listInquiries } from "../../../lib/inquiries";

const env = await getCloudflareEnv();
const inquiries = await listInquiries(env.DB);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Inquiries | YX Admin</title>
    <style>
      :root {
        --navy: #0b1f3a;
        --steel: #4a5d73;
        --teal: #0d9488;
        --ice: #f3f6f9;
        --line: rgba(11, 31, 58, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family:
          "IBM Plex Sans",
          "Segoe UI",
          sans-serif;
        color: var(--navy);
        background: var(--ice);
        line-height: 1.5;
      }

      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2.5rem 1.25rem 4rem;
      }

      header {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem 1.5rem;
        margin-bottom: 1.75rem;
      }

      h1 {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 600;
      }

      .meta {
        color: var(--steel);
        font-size: 0.95rem;
      }

      .table-wrap {
        overflow-x: auto;
        border: 1px solid var(--line);
        background: #fff;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        min-width: 720px;
      }

      th,
      td {
        padding: 0.85rem 1rem;
        text-align: left;
        vertical-align: top;
        border-bottom: 1px solid var(--line);
        font-size: 0.95rem;
      }

      th {
        font-size: 0.75rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--steel);
        background: #f8fafc;
        white-space: nowrap;
      }

      tr:last-child td {
        border-bottom: none;
      }

      .email a {
        color: var(--teal);
        text-decoration: none;
      }

      .email a:hover {
        text-decoration: underline;
      }

      .details {
        max-width: 28rem;
        white-space: pre-wrap;
        word-break: break-word;
      }

      .empty {
        padding: 3rem 1.5rem;
        text-align: center;
        color: var(--steel);
        background: #fff;
        border: 1px solid var(--line);
      }

      .back {
        display: inline-block;
        margin-top: 1.5rem;
        color: var(--steel);
        font-size: 0.9rem;
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <h1>Inquiry submissions</h1>
        <p class="meta">{inquiries.length} total</p>
      </header>

      {
        inquiries.length === 0 ? (
          <div class="empty">No inquiries yet.</div>
        ) : (
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Received</th>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Country</th>
                  <th>Details</th>
                </tr>
              </thead>
              <tbody>
                {inquiries.map((row) => (
                  <tr>
                    <td>{row.id}</td>
                    <td>{row.created_at}</td>
                    <td>{row.name}</td>
                    <td class="email">
                      <a href={`mailto:${row.email}`}>{row.email}</a>
                    </td>
                    <td>{row.country ?? "—"}</td>
                    <td class="details">{row.application_details}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }

      <a class="back" href="/">← Back to site</a>
    </main>
  </body>
</html>
