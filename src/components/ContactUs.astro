---
import { actions, isInputError } from "astro:actions";
import type { ActionReturnType } from "astro:actions";

interface Props {
  result?: ActionReturnType<typeof actions.submitInquiry> | undefined;
}

const { result } = Astro.props;
const inputErrors = isInputError(result?.error) ? result.error.fields : {};
const hasFormError = Boolean(result?.error);

const contacts = [
  {
    role: "Sales Director",
    name: "Sharon Wu",
    email: "sharon@yxsemiconductor.com",
    phoneDisplay: "+86 134 2794 4596",
    phoneHref: "tel:+8613427944596",
  },
  {
    role: "Sales Manager",
    name: "Jady Zhou",
    email: "jady@yxsemiconductor.com",
    phoneDisplay: "+86 180 1876 9670",
    phoneHref: "tel:+8618018769670",
  },
] as const;
---

<section id="contact" class="relative overflow-hidden bg-navy py-28">
  <div class="absolute inset-0 opacity-20 dot-grid" aria-hidden="true"></div>
  <div
    class="absolute top-0 left-1/2 h-64 w-[800px] -translate-x-1/2 rounded-full opacity-10"
    style="background:radial-gradient(ellipse,#0D7E8A 0%,transparent 70%)"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-6">
    <div class="mb-16 text-center">
      <span
        class="mb-5 inline-block rounded-full border border-teal/40 px-4 py-1.5 text-xs font-500 tracking-widest text-teal-light uppercase"
      >
        Contact Us
      </span>
      <h2 class="mb-4 font-display text-5xl text-white">Let's Work Together</h2>
    </div>

    <div class="grid items-start gap-10 lg:grid-cols-2">
      <div>
        <div class="mb-6">
          <h3 class="mb-2 font-display text-3xl text-white">Contact Team</h3>
          <p class="text-sm text-silver/60">
            Reach our sales contacts directly for product and application
            support.
          </p>
        </div>

        <div class="space-y-6">
          {
            contacts.map((contact) => (
              <div class="card-lift rounded-2xl border border-white/10 bg-navy-light p-8">
                <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
                  <div class="flex items-center gap-4">
                    <div class="flex h-16 w-16 items-center justify-center rounded-full border border-teal/30 bg-teal/20">
                      <svg
                        width="28"
                        height="28"
                        viewBox="0 0 28 28"
                        fill="none"
                        aria-hidden="true"
                      >
                        <circle
                          cx="14"
                          cy="10"
                          r="6"
                          stroke="#16A4B4"
                          stroke-width="1.3"
                        />
                        <path
                          d="M4 24a10 10 0 0120 0"
                          stroke="#16A4B4"
                          stroke-width="1.3"
                          stroke-linecap="round"
                        />
                      </svg>
                    </div>
                    <div>
                      <div class="mb-1 text-xs font-500 tracking-widest text-teal-light uppercase">
                        {contact.role}
                      </div>
                      <h3 class="font-display text-2xl text-white">
                        {contact.name}
                      </h3>
                    </div>
                  </div>

                  <div class="space-y-3 text-sm md:min-w-[260px]">
                    <a
                      href={`mailto:${contact.email}`}
                      class="group flex items-center gap-3 text-silver/70 transition-colors hover:text-teal-light"
                    >
                      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-white/5 transition-colors group-hover:bg-teal/10">
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 14 14"
                          fill="none"
                          aria-hidden="true"
                        >
                          <rect
                            x="1"
                            y="3"
                            width="12"
                            height="8"
                            rx="1.5"
                            stroke="#C8D6E5"
                            stroke-width="1.2"
                          />
                          <path
                            d="M1 4l6 4 6-4"
                            stroke="#C8D6E5"
                            stroke-width="1.2"
                            stroke-linecap="round"
                          />
                        </svg>
                      </div>
                      {contact.email}
                    </a>
                    <a
                      href={contact.phoneHref}
                      class="group flex items-center gap-3 text-silver/70 transition-colors hover:text-teal-light"
                    >
                      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-white/5 transition-colors group-hover:bg-teal/10">
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 14 14"
                          fill="none"
                          aria-hidden="true"
                        >
                          <path
                            d="M2 2.5A1.5 1.5 0 013.5 1h1a1 1 0 011 .8L6 3.6a1 1 0 01-.28 1l-.7.7a7.35 7.35 0 003.68 3.68l.7-.7a1 1 0 011-.28l1.8.5a1 1 0 01.8 1V11A1.5 1.5 0 0111.5 12.5C6.25 12.5 1.5 7.75 1.5 2.5z"
                            stroke="#C8D6E5"
                            stroke-width="1.2"
                          />
                        </svg>
                      </div>
                      {contact.phoneDisplay}
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div id="inquiry" class="lg:sticky lg:top-24">
        <div class="rounded-2xl border border-white/10 bg-navy-light p-10">
          <h3 class="mb-2 font-display text-3xl text-white">Send an Inquiry</h3>
          <p class="mb-8 text-sm text-silver/50">
            Describe your CMP application and we'll find the optimal solution.
          </p>

          {
            hasFormError && (
              <p
                class="mb-5 rounded-xl border border-red-400/40 bg-red-400/10 px-4 py-3 text-sm text-red-200"
                role="alert"
              >
                Please check the highlighted fields and try again.
              </p>
            )
          }

          <form method="POST" action={actions.submitInquiry}>
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label
                  class="mb-2 block text-xs font-500 tracking-widest text-silver/50 uppercase"
                  for="inquiry-name"
                >
                  Name <span class="text-red-400">*</span>
                </label>
                <input
                  id="inquiry-name"
                  type="text"
                  maxlength="100"
                  name="name"
                  placeholder="Your name"
                  required
                  aria-invalid={Boolean(inputErrors.name) || undefined}
                  aria-describedby={inputErrors.name ? "error-name" : undefined}
                  class="w-full rounded-xl border border-white/10 bg-navy px-4 py-3 text-sm text-white outline-none transition-colors placeholder-silver/30 focus:border-teal/50"
                />
                {
                  inputErrors.name && (
                    <p id="error-name" class="mt-2 text-xs text-red-300">
                      {inputErrors.name.join(", ")}
                    </p>
                  )
                }
              </div>

              <div>
                <label
                  class="mb-2 block text-xs font-500 tracking-widest text-silver/50 uppercase"
                  for="inquiry-email"
                >
                  Email <span class="text-red-400">*</span>
                </label>
                <input
                  id="inquiry-email"
                  type="email"
                  maxlength="254"
                  name="email"
                  placeholder="your@email.com"
                  required
                  aria-invalid={Boolean(inputErrors.email) || undefined}
                  aria-describedby={inputErrors.email ? "error-email" : undefined}
                  class="w-full rounded-xl border border-white/10 bg-navy px-4 py-3 text-sm text-white outline-none transition-colors placeholder-silver/30 focus:border-teal/50"
                />
                {
                  inputErrors.email && (
                    <p id="error-email" class="mt-2 text-xs text-red-300">
                      {inputErrors.email.join(", ")}
                    </p>
                  )
                }
              </div>

              <div>
                <label
                  class="mb-2 block text-xs font-500 tracking-widest text-silver/50 uppercase"
                  for="inquiry-country"
                >
                  Country
                </label>
                <input
                  id="inquiry-country"
                  type="text"
                  maxlength="100"
                  name="country"
                  placeholder="Your country"
                  class="w-full rounded-xl border border-white/10 bg-navy px-4 py-3 text-sm text-white outline-none transition-colors placeholder-silver/30 focus:border-teal/50"
                />
              </div>

              <div class="sm:col-span-2">
                <label
                  class="mb-2 block text-xs font-500 tracking-widest text-silver/50 uppercase"
                  for="inquiry-details"
                >
                  Application Details <span class="text-red-400">*</span>
                </label>
                <textarea
                  id="inquiry-details"
                  rows="4"
                  maxlength="300"
                  name="application_details"
                  placeholder="Describe your CMP process, wafer size, target spec, or any specific requirements…"
                  required
                  aria-invalid={
                    Boolean(inputErrors.application_details) || undefined
                  }
                  aria-describedby={
                    inputErrors.application_details
                      ? "error-details"
                      : undefined
                  }
                  class="w-full resize-none rounded-xl border border-white/10 bg-navy px-4 py-3 text-sm text-white outline-none transition-colors placeholder-silver/30 focus:border-teal/50"
                ></textarea>
                {
                  inputErrors.application_details && (
                    <p id="error-details" class="mt-2 text-xs text-red-300">
                      {inputErrors.application_details.join(", ")}
                    </p>
                  )
                }
              </div>
            </div>

            <button
              type="submit"
              class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-teal py-4 font-500 text-white transition-colors hover:bg-teal-light"
            >
              Send Inquiry
              <svg
                width="18"
                height="18"
                viewBox="0 0 18 18"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M3.5 9H14.5M14.5 9L10.5 5M14.5 9L10.5 13"
                  stroke="white"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
